<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ls_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/ls_widget_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ls_widget_background" android:scaleType="fitXY" android:alpha="1" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:id="@+id/ls_widget_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="今日课表" android:textSize="17sp" android:textStyle="bold" android:textColor="#203047" android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/ls_widget_day" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="36dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:gravity="center" android:text="明日" android:textSize="11sp" android:textColor="#527DA8" android:contentDescription="查看明日课程" android:clickable="true" />
    </LinearLayout>
    <TextView android:id="@+id/ls_widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="湖畔课表 · 教学周" android:textColor="#526B85" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <ListView android:id="@+id/ls_widget_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="5dp" android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent" android:listSelector="@android:color/transparent" />
      <LinearLayout android:id="@+id/ls_widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:clickable="true">
        <TextView android:id="@+id/ls_widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="打开湖畔课表以同步" android:textSize="14sp" android:textColor="#527DA8" android:textStyle="bold" />
        <TextView android:id="@+id/ls_widget_empty_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="点击打开课表" android:textSize="12sp" android:textColor="#71869D" />
      </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:id="@+id/ls_widget_remaining" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:text="查看今日课表 ›" android:textColor="#526B85" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:clickable="true" />
      <TextView android:id="@+id/ls_widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="36dp" android:gravity="center_vertical" android:paddingStart="8dp" android:text="点击刷新 ↻" android:textSize="10sp" android:textColor="#71869D" android:maxLines="1" android:clickable="true" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
